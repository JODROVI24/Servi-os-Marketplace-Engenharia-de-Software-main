{
  "version": 2,
  "cleanUrls": true,
  "functions": {
    "api/index.py": {
      "includeFiles": "Servi-os-Marketplace-Engenharia-de-Software-main/**"
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index.py"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    }
  ]
}
