# ==============================================================================
# Configurações do Servidor PertoJá Marketplace
# Copie este arquivo para .env apenas em desenvolvimento local (nunca faça commit do .env real)
# ==============================================================================

# Chave secreta para assinatura de sessões Flask (gere com: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=sua_chave_secreta_aleatoria_aqui

# ==============================================================================
# Configurações de Banco de Dados (Dual-Engine: PostgreSQL / SQLite)
# ==============================================================================
# Prioridade de resolução:
# 1. DATABASE_URL
# 2. POSTGRES_URL (Vercel Postgres pooled)
# 3. POSTGRES_URL_NON_POOLING (Vercel Postgres direct)
# MARKETPLACE_DB=marketplace.db

# ==============================================================================
# Gateways de Pagamento (opcional em dev; quando ausentes usa sandbox se ALLOW_SANDBOX_PAYMENTS=1)
# ==============================================================================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAGSEGURO_TOKEN=
PAGSEGURO_CLIENT_ID=
PAGSEGURO_WEBHOOK_SECRET=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=
ALLOW_SANDBOX_PAYMENTS=1

# ==============================================================================
# Sistema
# ==============================================================================
FLASK_ENV=development
VERCEL=0
ENABLE_DEMO_SEED=1
