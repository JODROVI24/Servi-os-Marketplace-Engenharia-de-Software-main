# ==============================================================================
# PertoJá Marketplace - Exemplo de Variáveis de Ambiente (.env.example)
# ==============================================================================
# Copie este arquivo para ".env" em ambiente local ou configure estas variáveis
# no painel da Vercel (Settings -> Environment Variables).
# NUNCA faça commit do arquivo ".env" real no Git!

# Chave secreta para assinatura de sessões Flask (gere com: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=sua_chave_secreta_aleatoria_aqui

# Caminho opcional para banco SQLite customizado (em produção na Vercel usa /tmp/marketplace.db automaticamente)
# MARKETPLACE_DB=/tmp/marketplace.db
