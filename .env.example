# ==============================================================================
# PertoJá Marketplace - Exemplo de Variáveis de Ambiente (.env.example)
# ==============================================================================
# Copie este arquivo para ".env" em ambiente local ou configure estas variáveis
# no painel da Vercel (Settings -> Environment Variables).
# NUNCA faça commit do arquivo ".env" real no Git!

# Chave secreta para assinatura de sessões Flask (gere com: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=sua_chave_secreta_aleatoria_aqui

# ======================
# Pay de Pagamento
# ======================
# Chaves de API para gateways de pagamento. Substitua pelos valores reais.
# Nunca commit um arquivo .env com credenciais reais.
#
# Stripe (sandbox)
STRIPE_SECRET_KEY=sk_test_sua_chave_secret_here
STRIPE_WEBHOOK_SECRET=whsec_sua_webhook_secret_here

# PagSeguro
PAGSEGURO_TOKEN=seu_token_pagseguro_here
PAGSEGURO_CLIENT_ID=seu_client_id_pagseguro_here

# Mercado Pago (credentials are set at runtime via .env or environment)
MERCADOPAGO_ACCESS_TOKEN=[REDACTED]
MERCADOPAGO_PUBLIC_KEY=[REDACTED]

# ======================
# Sistema
# ======================
FLASK_ENV=development
VERCEL=0
ENABLE_DEMO_SEED=1
