# ==============================================================================
# PertoJá Marketplace - Exemplo de Variáveis de Ambiente (.env.example)
# ==============================================================================
# Copie este arquivo para ".env" em ambiente local ou configure estas variáveis
# no painel da Vercel (Settings -> Environment Variables).
# NUNCA faça commit do arquivo ".env" real no Git!

# Chave secreta para assinatura de sessões Flask (gere com: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=sua_chave_secreta_aleatoria_aqui

# ==============================================================================
# Configurações de Banco de Dados (Dual-Engine: PostgreSQL / SQLite)
# ==============================================================================
# O sistema suporta PostgreSQL em nuvem (Vercel Postgres, Neon, Supabase, etc.)
# com fallback automático e transparente para SQLite local quando não configurado.
#
# Prioridade de resolução de variáveis de ambiente:
# 1. DATABASE_URL
# 2. POSTGRES_URL (injetada automaticamente pela integração Vercel Postgres)
# 3. POSTGRES_URL_NON_POOLING (conexão direta da integração Vercel Postgres)
#
# Regras de normalização:
# - Esquemas legados 'postgres://' são automaticamente normalizados para 'postgresql://'.
# - Parâmetro 'sslmode=require' é automaticamente adicionado para conexões remotas se omitido.
#
# Exemplo PostgreSQL:
# DATABASE_URL=postgresql://usuario:senha@ep-exemplo.us-east-1.aws.neon.tech/neondb?sslmode=require
# POSTGRES_URL=postgres://default:senha@ep-pooler.us-east-1.postgres.vercel-storage.com/verceldb
# POSTGRES_URL_NON_POOLING=postgres://default:senha@ep-direct.us-east-1.postgres.vercel-storage.com/verceldb

# Caminho para o banco SQLite local padrão (em produção na Vercel sem PostgreSQL usa /tmp/marketplace.db)
MARKETPLACE_DB=marketplace.db

# Seed de contas e prestadores de demonstração (somente desenvolvimento local; padrão: 0)
# Em produção (VERCEL=1 ou FLASK_ENV=production), o seed é sempre bloqueado por segurança.
# ENABLE_DEMO_SEED=0

# ==============================================================================
# Configurações de Gateways de Pagamento (PCI-Safe / Opcional)
# ==============================================================================
# Em ambiente local/desenvolvimento (VERCEL != 1 e FLASK_ENV != production),
# o gateway Sandbox fica habilitado automaticamente. Defina ENABLE_PAYMENT_SANDBOX=1
# para habilitar explicitamente ou 0 para desabilitar.
# ENABLE_PAYMENT_SANDBOX=1
# SANDBOX_WEBHOOK_SECRET=segredo_hmac_sandbox_opcional

# URL base pública usada para montar URLs de retorno de checkout (opcional)
# PAYMENT_RETURN_BASE_URL=https://seu-dominio.vercel.app

# Mercado Pago (PIX, Cartão e Boleto)
# MERCADOPAGO_ACCESS_TOKEN=APP_USR-...
# MERCADOPAGO_PUBLIC_KEY=APP_USR-...
# MERCADOPAGO_WEBHOOK_SECRET=segredo_webhook_mercadopago

# Stripe (Cartão, PIX e Boleto)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# PagSeguro (PIX, Cartão e Boleto)
# PAGSEGURO_TOKEN=token_pagseguro
# PAGSEGURO_WEBHOOK_SECRET=segredo_webhook_pagseguro

# ==============================================================================
# Configurações de LLM / Chat (FreeLLMAPI local + Provedores Cloud Gratuitos)
# ==============================================================================
# Em ambiente local, você pode usar o gateway FreeLLMAPI em localhost:3001/v1.
# Em produção/serverless (Vercel), URLs localhost são ignoradas automaticamente
# e o roteador utiliza os provedores cloud gratuitos configurados abaixo
# (com failover automático entre eles e fallback offline local se nenhum responder).
#
# URL base do gateway local (OpenAI-compatível). Aliases suportados: OPENAI_BASE_URL.
FREELLM_API_BASE_URL=http://localhost:3001/v1
# OPENAI_BASE_URL=http://localhost:3001/v1

# Chave de acesso ao gateway FreeLLMAPI (opcional em dev local; aliases: OPENAI_API_KEY).
FREELLM_API_KEY=freellmapi-[seu_token_aqui]
# OPENAI_API_KEY=freellmapi-[seu_token_aqui]

# Modelo padrão para FreeLLMAPI (use "auto" por padrão).
# Aliases suportados: LLAMA_MODEL. Quando um provedor cloud for o primário e LLM_MODEL="auto"
# ou vazio, o cliente seleciona automaticamente o modelo gratuito recomendado do provedor.
LLM_MODEL=auto
# LLAMA_MODEL=auto

# --- Provedores Cloud Gratuitos (recomendado para Vercel / Serverless & Failover) ---
# Basta configurar uma ou mais chaves abaixo (ordem de prioridade automática):
# 1. Groq (rápido, modelo padrão: openai/gpt-oss-20b, fallbacks: openai/gpt-oss-120b / qwen/qwen3.8-27b)
# GROQ_API_KEY=gsk_seu_token_groq

# 2. Google Gemini AI Studio (modelo padrão: gemini-3.5-flash-lite, fallbacks: gemini-3.1-flash-lite / gemini-3.8-flash; aceita GEMINI_API_KEY ou GOOGLE_API_KEY)
# GEMINI_API_KEY=AIza_sua_chave_gemini

# 3. OpenRouter (roteador gratuito, modelo padrão: openrouter/free)
# OPENROUTER_API_KEY=sk-or-v1-sua_chave_openrouter

# 4. Cerebras (modelo padrão: llama-3.3-70b)
# CEREBRAS_API_KEY=csk-sua_chave_cerebras

# 5. Mistral (modelo padrão: mistral-small-latest)
# MISTRAL_API_KEY=sua_chave_mistral

# 6. ApiFreeLLM (modelo padrão: free-ai)
# APIFREELLM_API_KEY=apf_sua_chave_apifreellm

# 7. GitHub Models (modelo padrão: gpt-4o-mini)
# GITHUB_MODELS_TOKEN=ghp_seu_token_github

# Define LLM_STRICT_MODE=1 caso deseje retornar HTTP 500 em vez do fallback
# determinístico local quando todos os provedores LLM estiverem indisponíveis.
# LLM_STRICT_MODE=0
