{
  "name": "pertoja-marketplace",
  "version": "2.0.0",
  "private": true,
  "description": "PertoJá Marketplace - Build de CSS e lint de segurança frontend",
  "scripts": {
    "build:css": "tailwindcss -i ./src/input.css -o ./public/dist/app.css --minify",
    "build": "npm run build:css",
    "lint:xss": "node scripts/check_xss_lint.js",
    "lint:eslint": "eslint public scripts tests/test_vercel_routing_adversarial.js",
    "lint:js": "npm run lint:xss && npm run lint:eslint",
    "test:routing": "node tests/test_vercel_routing_adversarial.js"
  },
  "devDependencies": {
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.9",
    "@vercel/routing-utils": "^6.6.1",
    "eslint": "^10.15.0",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "globals": "^17.14.0",
    "tailwindcss": "^4.3.5"
  },
  "overrides": {
    "path-to-regexp": "6.3.0"
  }
}
